# Flutter production environment
#
# Create the ignored local file:
#   cp config/env/production.example config/env/production.env
#
# Build:
#   flutter build web \
#     --dart-define-from-file=config/env/production.env

APP_ENV=production
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
APP_WEB_URL=https://app.soolgyul.com
AUTH_REDIRECT_URL=soolgyul://auth/callback
APP_STORE_URL=
# Where the web card's claim link lives; the intro site by default.
CLAIM_LINK_URL=https://soolgyul.com
PLAY_STORE_URL=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=
KAKAO_NATIVE_APP_KEY=
KAKAO_NATIVE_APP_SCHEME=
SOOL_SCREEN=
# Error collection (Sentry). Empty leaves it off.
SENTRY_DSN=
